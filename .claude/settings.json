{
  "effortLevel": "high",
  "enabledMcpjsonServers": [],
  "enabledPlugins": {
    "kk@claude-toolbox": true
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_STATUSLINE_MODE": "dark",
    "CLAUDE_STATUSLINE_THEME": "catppuccin",
    "MAX_MCP_OUTPUT_TOKENS": "64000"
  },
  "extraKnownMarketplaces": {
    "claude-toolbox": {
      "source": {
        "source": "github",
        "repo": "serpro69/claude-toolbox"
      }
    }
  },
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(sort:*)",
      "WebSearch",
      "Skill(kk:*)",
      "Read(~/.claude/plugins/cache/claude-toolbox/*)",
      "Bash(echo \"${TOOLBOX_PLUGIN_ROOT}\")",
      "Bash(echo \"${TOOLBOX_PLUGIN_ROOT:-NOT_SET}\")",
      "Read(//tmp/**)"
    ],
    "ask": [],
    "defaultMode": "default",
    "deny": [
      "Read(./**/*.pem)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.local)",
      "Read(./**/.terraform/**)",
      "Read(./**/id_ecdsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/id_rsa)",
      "Read(./**/service-account*.json)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)"
    ]
  },
  "statusLine": {
    "command": "bash $CLAUDE_PROJECT_DIR/.claude/toolbox/scripts/statusline_enhanced.sh",
    "type": "command"
  }
}
